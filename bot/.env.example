# скопируй этот файл в bot/.env или добавь значения в окружение хостинга
TELEGRAM_BOT_TOKEN=REPLACE_WITH_YOUR_BOT_TOKEN
TELEGRAM_BOT_NAME=YOUR_BOT_USERNAME
TELEGRAM_CLIENT_ID=YOUR_WEB_LOGIN_CLIENT_ID
TELEGRAM_CLIENT_SECRET=REPLACE_WITH_YOUR_WEB_LOGIN_SECRET
TELEGRAM_OIDC_ALGORITHM=RS256
TELEGRAM_OWNER_ID=YOUR_TELEGRAM_ID
TELEGRAM_ADMIN_IDS=
BOT_PUBLIC_URL=https://YOUR_ACCOUNT.alwaysdata.net/sched-bot
SCHED_ALLOWED_ORIGINS=https://YOUR_ACCOUNT.github.io
NOTIFY_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
FIREBASE_SERVICE_ACCOUNT_FILE=/home/YOUR_ACCOUNT/sched/firebase-key.json
SCHED_REPORT_QUOTA_MB=256
# ip и port обычно задаются хостингом автоматически
# SCHED_DATA_DIR=/home/YOUR_ACCOUNT/sched/bot/data
