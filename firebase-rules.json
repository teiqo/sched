{
  "rules": {
    ".read": false,
    ".write": false,
    "weeqo-swaps": {
      ".read": true,
      "$key": {
        ".write": "auth != null && root.child('weeqo-users').child(auth.uid).exists() && (root.child('weeqo-meta/owner').val() === root.child('weeqo-users').child(auth.uid).val() || root.child('weeqo-editors').child(root.child('weeqo-users').child(auth.uid).val()).isString())",
        ".validate": "newData.val() === null || (newData.child('updatedAt').isNumber() && newData.child('updatedAt').val() <= now + 300000 && (!newData.child('subject').exists() || newData.child('subject').val().length <= 120) && (!newData.child('teacher').exists() || newData.child('teacher').val().length <= 120) && (!newData.child('room').exists() || newData.child('room').val().length <= 40))"
      }
    },
    "weeqo-pending": {
      ".read": "auth != null && root.child('weeqo-users').child(auth.uid).exists() && (root.child('weeqo-meta/owner').val() === root.child('weeqo-users').child(auth.uid).val() || root.child('weeqo-editors').child(root.child('weeqo-users').child(auth.uid).val()).isString())",
      "$key": {
        ".write": "auth != null && root.child('weeqo-users').child(auth.uid).exists() && (newData.exists() || root.child('weeqo-meta/owner').val() === root.child('weeqo-users').child(auth.uid).val() || root.child('weeqo-editors').child(root.child('weeqo-users').child(auth.uid).val()).isString())",
        ".validate": "newData.val() === null || (newData.child('updatedAt').isNumber() && newData.child('updatedAt').val() <= now + 300000 && newData.child('by').isString())"
      }
    },
    "weeqo-users": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid && !data.exists() && newData.isString() && newData.val().length <= 32"
      }
    },
    "weeqo-editors": {
      ".read": "auth != null",
      "$tgId": {
        ".write": "auth != null && root.child('weeqo-meta/owner').val() === root.child('weeqo-users').child(auth.uid).val()",
        ".validate": "newData.val() === null || (newData.isString() && newData.val().length <= 80)"
      }
    },
    "weeqo-meta": {
      ".read": "auth != null",
      "owner": {
        ".write": "auth != null && !data.exists() && newData.isString() && newData.val() === root.child('weeqo-users').child(auth.uid).val()"
      }
    },
    "weeqo-tg-subs": {
      ".read": "auth != null",
      "$tgId": {
        ".write": "auth != null && root.child('weeqo-users').child(auth.uid).val() === $tgId",
        ".validate": "newData.val() === null || (newData.child('name').isString() && newData.child('name').val().length <= 80 && newData.child('updatedAt').isNumber() && newData.child('updatedAt').val() <= now + 300000 && (!newData.child('swaps').exists() || newData.child('swaps').isBoolean()) && (!newData.child('schedule').exists() || newData.child('schedule').isBoolean()) && (!newData.child('pending').exists() || newData.child('pending').isBoolean()))"
      }
    },
    "weeqo-reports": {
      ".read": "auth != null && root.child('weeqo-meta/owner').val() === root.child('weeqo-users').child(auth.uid).val()",
      "$reportId": {
        ".write": "auth != null",
        ".validate": "newData.val() === null || (newData.child('createdAt').isNumber() && newData.child('message').isString() && newData.child('message').val().length <= 5000)"
      }
    }
  }
}
